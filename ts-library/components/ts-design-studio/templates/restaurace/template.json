{
  "id": "restaurace",
  "name": "Restaurace a bistro",
  "basedOn": "ukázka Kořen (web/ukazky/koren.html)",
  "obor": [
    "restaurace",
    "bistro",
    "vinárna",
    "kavárna",
    "jídelna",
    "pivnice"
  ],
  "description": "Jednostránkový web restaurace: tmavý „řez půdou“, svislé menu, dodavatelé s kilometry, ukázka menu a degustace, citace šéfkuchaře, otevírací doba a kontakt. Světlý režim tlačítkem.",
  "render": [
    "index.html",
    "assets/styles.css"
  ],
  "tokens": {
    "bg": {
      "var": "--bg",
      "type": "color",
      "value": "#201913",
      "label": "Pozadí"
    },
    "bg2": {
      "var": "--bg-2",
      "type": "color",
      "value": "#2b221b",
      "label": "Pozadí karet"
    },
    "bg3": {
      "var": "--bg-3",
      "type": "color",
      "value": "#3a2e24",
      "label": "Pozadí – třetí vrstva"
    },
    "deep": {
      "var": "--deep",
      "type": "color",
      "value": "#17120e",
      "label": "Tmavá sekce"
    },
    "deeper": {
      "var": "--deeper",
      "type": "color",
      "value": "#120e0b",
      "label": "Nejtmavší sekce"
    },
    "ink": {
      "var": "--ink",
      "type": "color",
      "value": "#e7e3da",
      "label": "Text"
    },
    "ink2": {
      "var": "--ink-2",
      "type": "color",
      "value": "#cfc4b1",
      "label": "Text – doplňkový"
    },
    "muted": {
      "var": "--muted",
      "type": "color",
      "value": "#9c8f7b",
      "label": "Text – tlumený"
    },
    "accent": {
      "var": "--wax",
      "type": "color",
      "value": "#c98a2b",
      "label": "Akcent (tlačítka, čáry)"
    },
    "band": {
      "var": "--wine",
      "type": "color",
      "value": "#5b1a2a",
      "label": "Pás s citací"
    },
    "band_ink": {
      "var": "--wine-ink",
      "type": "color",
      "value": "#f2e6e8",
      "label": "Text v pásu"
    },
    "f_disp": {
      "var": "--f-disp",
      "type": "font",
      "value": "\"Alegreya\",Georgia,\"Times New Roman\",serif",
      "options": [
        "\"Alegreya\",Georgia,\"Times New Roman\",serif",
        "Georgia,\"Times New Roman\",serif",
        "\"Iowan Old Style\",\"Palatino Linotype\",Palatino,serif"
      ],
      "label": "Písmo nadpisů"
    },
    "f_body": {
      "var": "--f-body",
      "type": "font",
      "value": "\"Alegreya Sans\",\"Gill Sans\",\"Trebuchet MS\",system-ui,sans-serif",
      "options": [
        "\"Alegreya Sans\",\"Gill Sans\",\"Trebuchet MS\",system-ui,sans-serif",
        "system-ui,-apple-system,\"Segoe UI\",sans-serif"
      ],
      "label": "Písmo textu"
    }
  },
