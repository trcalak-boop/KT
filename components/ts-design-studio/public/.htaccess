# Rozhraní AI Design Studia (JS a CSS) – načítá ho stránka administrace; data jdou jen přes API s přihlášením.
# Nadřazená složka vendor/ může být na hostingu zakázaná – tady se povolí jen soubory .js a .css.
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Allow from all
</IfModule>
<FilesMatch "\.(?!(js|css)$)[^.]+$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
